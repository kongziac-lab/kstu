# 공공데이터포털 인증키 (법무부_유학생관리정보 데이터)
# https://www.data.go.kr/data/3069982/fileData.do 에서 발급
# 이 파일은 커밋하지 말 것 (.env* 는 gitignore에 포함됨)
KDATA_API_KEY=

# (선택) 데이터 기준일. 없으면 scripts/sync-student-data.mjs 의 기본값 사용.
# KDATA_ASOF=2026-06-30

# (선택) API base URL. 기본값은 최신 엔드포인트.
# KDATA_BASE_URL=https://api.odcloud.kr/api/3069982/v1/uddi:b851d214-1a5c-4eeb-8566-ab7f1aeaa3db